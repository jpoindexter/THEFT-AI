# OS
.DS_Store
*.pem

# Visual reference frames (binary assets, not source)
frames/
frames2/
twinframes/
screenshots/
magic patch frames/

# Reference clones (not project code)
_reference/

# Extracted third-party app references. Keep only our inventory notes tracked.
reference-binaries/*/extracted/
reference-binaries/*/original/

# Paperclip is the tracked runtime host. Keep local clone metadata,
# dependencies, build outputs, and runtime data out of parent git.
paperclip/.git-upstream/
paperclip/node_modules/
paperclip/**/node_modules/
paperclip/dist/
paperclip/**/dist/
paperclip/.vite/
paperclip/coverage/
paperclip/data/
paperclip/.paperclip/
paperclip/.paperclip-local/
paperclip/.pnpm-store/
paperclip/tmp/
paperclip/tmp-*/
paperclip/cli/tmp/
paperclip/diagnostics/
paperclip/feedback-export-*
paperclip/ui/storybook-static/
paperclip/drizzle/meta/
paperclip/tests/e2e/test-results/
paperclip/tests/e2e/playwright-report/
paperclip/tests/release-smoke/test-results/
paperclip/tests/release-smoke/playwright-report/
paperclip/.superset/

# Claude Code local config
.claude/

# Node
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts
.vercel

# Testing
/coverage

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Env
.env*
!.env.example
!paperclip/.env.example
!paperclip/docker/.env.aws.example

# App data
.theft-data/
app/.theft-data/
app/.theft-data*/
